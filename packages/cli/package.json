{
  "name": "@fumadocs/cli",
  "version": "1.5.0",
  "description": "The CLI tool for Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "bin": {
    "cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./codemod": "./dist/codemod/index.js",
    "./config": "./dist/config.js",
    "./features": "./dist/features/index.js",
    "./features/ai": "./dist/features/ai.js",
    "./features/all": "./dist/features/all.js",
    "./features/docs": "./dist/features/docs/index.js",
    "./project": "./dist/project/index.js",
    "./registry/installer": "./dist/registry/installer.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "fuma-cli": "^0.1.1",
    "magic-string": "^1.2.3",
    "oxc-parser": "^0.128.0",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14"
  }
}
