{
  "name": "@fumadocs/ai-chat",
  "version": "0.1.1",
  "description": "AI chat UI for Fumadocs, built on AI SDK",
  "keywords": [
    "AI",
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "files": [
    "css",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./css/**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./i18n": "./dist/i18n.js",
    "./package.json": "./package.json",
    "./css/*": "./css/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fuma-translate/react": "^1.0.2",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "remend": "^1.4.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.147",
    "@types/hast": "^3.0.5",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "ai": "^7.0.143",
    "fuma-cli": "^0.3.1",
    "fumadocs-core": "workspace:*",
    "fumadocs-ui": "workspace:@fumadocs/base-ui@*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.1"
  },
  "peerDependencies": {
    "@ai-sdk/react": "^4.0.0",
    "@types/react": "*",
    "ai": "^7.0.0",
    "fumadocs-core": "^16.17.8",
    "fumadocs-ui": "^16.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
