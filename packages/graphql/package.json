{
  "name": "@fumadocs/graphql",
  "version": "0.4.1",
  "description": "Generate docs for your GraphQL schema",
  "keywords": [
    "Docs",
    "Fumadocs",
    "GraphQL"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "files": [
    "css",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./css/**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./i18n": "./dist/i18n.js",
    "./operation": "./dist/operation.js",
    "./playground": "./dist/playground/index.js",
    "./server": "./dist/server/index.js",
    "./type-docs": "./dist/type-docs.js",
    "./ui": "./dist/ui/index.js",
    "./ui/playground": "./dist/ui/playground/index.js",
    "./package.json": "./package.json",
    "./css/*": "./css/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/json-schema": "workspace:^",
    "@fumari/stf": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "eventsource-parser": "^4.1.2",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.59.0",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fuma-cli": "^0.3.1",
    "fumadocs-core": "workspace:*",
    "fumadocs-ui": "workspace:@fumadocs/base-ui@*",
    "graphql": "^17.0.2",
    "json-schema-typed": "^9.0.0",
    "shared-api": "workspace:*",
    "tailwindcss": "^4.3.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.1"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "^16.17.8",
    "fumadocs-ui": "^16.17.8",
    "graphql": "^17.0.0",
    "json-schema-typed": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "json-schema-typed": {
      "optional": true
    }
  }
}
