{
  "name": "@fumadocs/changelog",
  "version": "0.0.1",
  "description": "Changelog entries from your releases",
  "keywords": [
    "Changelog",
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./github": "./dist/github.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "vitest": "^5.0.3"
  }
}
