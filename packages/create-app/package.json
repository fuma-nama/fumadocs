{
  "name": "create-fumadocs-app",
  "version": "16.2.2",
  "description": "Create a new documentation site with Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs",
    "react"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "bin": "./dist/bin.js",
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run sync && tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit",
    "sync": "node ./scripts/sync.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@fumadocs/cli": "workspace:*",
    "cac": "^7.0.0",
    "fuma-cli": "^0.1.1",
    "picocolors": "^1.1.1",
    "tinyexec": "^1.3.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "26.5.0",
    "tinyglobby": "^0.2.17",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
