{
  "name": "@fumadocs/asyncapi",
  "version": "0.6.1",
  "description": "Generate docs for your AsyncAPI spec",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "files": [
    "css",
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./css/**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js"
    },
    "./i18n": "./dist/i18n.js",
    "./operation": "./dist/operation.js",
    "./playground": "./dist/playground.js",
    "./press": "./dist/press.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./package.json": "./package.json",
    "./css/*": "./css/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fuma-translate/react": "^1.0.2",
    "@fumadocs/json-schema": "workspace:^",
    "@fumari/json-schema-ts": "^1.0.2",
    "@fumari/stf": "workspace:^",
    "@scalar/json-magic": "^0.19.0",
    "chokidar": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "eventsource-parser": "^4.1.3",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.71.0",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fuma-cli": "^0.3.4",
    "fumadocs-core": "workspace:*",
    "fumadocs-ui": "workspace:@fumadocs/base-ui@*",
    "json-schema-typed": "^9.0.0",
    "shared-api": "workspace:*",
    "tailwindcss": "^4.3.5",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.7"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "^16.17.11",
    "fumadocs-ui": "^16.17.8",
    "json-schema-typed": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "json-schema-typed": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
