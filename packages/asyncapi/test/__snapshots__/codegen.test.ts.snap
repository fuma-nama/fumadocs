  console.log(event.data);
});"
`;

exports[`WebSocket > js > send 1`] = `
"const payload = {
  "id": "streetlight-1",
  "lumens": 3,
  "on": true,
  "note": null
};

const socket = new WebSocket("wss://api.example.com/v1/lights?api_key=YOUR_API_KEY");

socket.addEventListener("open", () => {
  socket.send(JSON.stringify(payload));
});"
`;

exports[`WebSocket > python > receive 1`] = `
"import asyncio

from websockets.asyncio.client import connect


async def main():
    async with connect("wss://api.example.com/v1/lights?api_key=YOUR_API_KEY") as websocket:
        async for message in websocket:
            print(message)


asyncio.run(main())"
`;

exports[`WebSocket > python > send 1`] = `
"import asyncio
import json

from websockets.asyncio.client import connect

payload = {
    "id": "streetlight-1",
    "lumens": 3,
    "on": True,
    "note": None
}


async def main():
    async with connect("wss://api.example.com/v1/lights?api_key=YOUR_API_KEY") as websocket:
        await websocket.send(json.dumps(payload))


asyncio.run(main())"
`;
