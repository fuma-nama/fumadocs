exports[`AMQP queue > python > receive 1`] = `
"import pika


def on_message(channel, method, properties, body):
    print(body.decode())


connection = pika.BlockingConnection(pika.URLParameters("amqps://broker.example.com"))
channel = connection.channel()
channel.basic_consume("measurements", on_message, auto_ack=True)
channel.start_consuming()"
`;

