exports[`Kafka > js > receive 1`] = `
"import { Kafka } from "kafkajs";

const kafka = new Kafka({ clientId: "app", brokers: ["broker.example.com:9093"], ssl: true });
const consumer = kafka.consumer({ groupId: "lights" });

await consumer.connect();
await consumer.subscribe({ topics: ["lights.measured"] });
await consumer.run({
  eachMessage: async ({ message }) => {
    console.log(message.value.toString());
  },
});"
`;

exports[`Kafka > js > send 1`] = `
"import { Kafka } from "kafkajs";

const payload = {
  "id": "streetlight-1",
  "lumens": 3,
  "on": true,
  "note": null
};

const kafka = new Kafka({ clientId: "app", brokers: ["broker.example.com:9093"], ssl: true });
const producer = kafka.producer();

await producer.connect();
await producer.send({
  topic: "lights.measured",
  messages: [{ key: "streetlight-1", value: JSON.stringify(payload), headers: { "my-app-header": "12" } }],
});
await producer.disconnect();"
`;

exports[`Kafka > python > receive 1`] = `
"from confluent_kafka import Consumer

consumer = Consumer({
    "bootstrap.servers": "broker.example.com:9093",
    "group.id": "lights",
    "client.id": "app",
    "security.protocol": "SSL"
})
consumer.subscribe(["lights.measured"])

while True:
    message = consumer.poll(1.0)
    if message is not None and not message.error():
        print(message.value().decode())"
`;

exports[`Kafka > python > send 1`] = `
"import json

from confluent_kafka import Producer

payload = {
    "id": "streetlight-1",
    "lumens": 3,
    "on": True,
    "note": None
}

producer = Producer({
    "bootstrap.servers": "broker.example.com:9093",
    "client.id": "app",
    "security.protocol": "SSL"
})
producer.produce("lights.measured", json.dumps(payload), key="streetlight-1", headers={
    "my-app-header": "12"
})
producer.flush()"
`;

