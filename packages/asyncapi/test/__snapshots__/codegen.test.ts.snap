  console.log(message.toString());
});
await client.subscribeAsync("lights/measured", { qos: 1 });"
`;

exports[`MQTT > js > send 1`] = `
"import { connectAsync } from "mqtt";

const payload = {
  "id": "streetlight-1",
  "lumens": 3,
  "on": true,
  "note": null
};

const client = await connectAsync("mqtts://broker.example.com");

await client.publishAsync("lights/measured", JSON.stringify(payload), { qos: 1, retain: true });
await client.endAsync();"
`;

exports[`MQTT > python > receive 1`] = `
"import paho.mqtt.client as mqtt


def on_connect(client, userdata, flags, reason_code, properties):
    client.subscribe("lights/measured", qos=1)


def on_message(client, userdata, message):
    print(message.payload.decode())


client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
client.on_connect = on_connect
client.on_message = on_message
client.tls_set()
client.connect("broker.example.com", 8883)
client.loop_forever()"
`;

exports[`MQTT > python > send 1`] = `
"import json

import paho.mqtt.client as mqtt

payload = {
    "id": "streetlight-1",
    "lumens": 3,
    "on": True,
    "note": None
}

client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
client.tls_set()
client.connect("broker.example.com", 8883)
client.loop_start()
client.publish("lights/measured", json.dumps(payload), qos=1, retain=True).wait_for_publish()
client.disconnect()
client.loop_stop()"
`;

exports[`NATS > js > receive 1`] = `
"import { connect } from "@nats-io/transport-node";

const nc = await connect({ servers: "nats://broker.example.com:4222" });
const sub = nc.subscribe("lights.measured", { queue: "workers" });

for await (const message of sub) {
  console.log(message.string());
}"
`;

exports[`NATS > js > send 1`] = `
"import { connect, headers } from "@nats-io/transport-node";

const payload = {
  "id": "streetlight-1",
  "lumens": 3,
  "on": true,
  "note": null
};

const nc = await connect({ servers: "nats://broker.example.com:4222" });
const h = headers();
h.set("my-app-header", "12");

nc.publish("lights.measured", JSON.stringify(payload), { headers: h });
await nc.drain();"
`;

exports[`NATS > python > receive 1`] = `
"import asyncio

import nats


async def main():
    nc = await nats.connect("nats://broker.example.com:4222")
    sub = await nc.subscribe("lights.measured", queue="workers")
    async for message in sub.messages:
        print(message.data.decode())


asyncio.run(main())"
`;

exports[`NATS > python > send 1`] = `
"import asyncio
import json

import nats

payload = {
    "id": "streetlight-1",
    "lumens": 3,
    "on": True,
    "note": None
}


async def main():
    nc = await nats.connect("nats://broker.example.com:4222")
    await nc.publish("lights.measured", json.dumps(payload).encode(), headers={
        "my-app-header": "12"
    })
    await nc.drain()


asyncio.run(main())"
`;

