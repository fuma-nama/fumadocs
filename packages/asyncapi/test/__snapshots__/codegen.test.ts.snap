exports[`AMQP exchange > js > receive 1`] = `
"import { connect } from "amqplib";

const connection = await connect("amqp://broker.example.com:5672/city");
const channel = await connection.createChannel();

const { queue } = await channel.assertQueue("", { exclusive: true });
await channel.bindQueue(queue, "lights", "lights.measured");
await channel.consume(queue, (message) => {
  console.log(message.content.toString());
  channel.ack(message);
});"
`;

exports[`AMQP exchange > js > send 1`] = `
"import { connect } from "amqplib";

const payload = {
  "id": "streetlight-1",
  "lumens": 3,
  "on": true,
  "note": null
};

const connection = await connect("amqp://broker.example.com:5672/city");
const channel = await connection.createChannel();

channel.publish("lights", "lights.measured", Buffer.from(JSON.stringify(payload)), { contentType: "application/json", headers: { "my-app-header": 12 } });
await channel.close();
await connection.close();"
`;

exports[`AMQP exchange > python > receive 1`] = `
"import pika


def on_message(channel, method, properties, body):
    print(body.decode())
    channel.basic_ack(method.delivery_tag)


connection = pika.BlockingConnection(pika.URLParameters("amqp://broker.example.com:5672/city"))
channel = connection.channel()
queue = channel.queue_declare("", exclusive=True).method.queue
channel.queue_bind(queue, "lights", "lights.measured")
channel.basic_consume(queue, on_message)
channel.start_consuming()"
`;

exports[`AMQP exchange > python > send 1`] = `
"import json

import pika

payload = {
    "id": "streetlight-1",
    "lumens": 3,
    "on": True,
    "note": None
}

connection = pika.BlockingConnection(pika.URLParameters("amqp://broker.example.com:5672/city"))
channel = connection.channel()
channel.basic_publish("lights", "lights.measured", json.dumps(payload), pika.BasicProperties(content_type="application/json", headers={
    "my-app-header": 12
}))
connection.close()"
`;

