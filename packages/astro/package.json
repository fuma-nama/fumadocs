{
  "name": "@fumadocs/astro",
  "version": "0.2.2",
  "description": "The Astro integration for Fumadocs",
  "keywords": [
    "Astro",
    "Docs",
    "astro-integration",
    "fumadocs",
    "withastro"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./loaders": "./dist/loaders.js",
    "./source": "./dist/source.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@fumadocs/satteri": "workspace:^",
    "devalue": "^6.0.2",
    "satteri": "^0.11.7",
    "yaml": "^2.9.1",
    "yuku-parser": "^0.19.0"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/react": "^7.1.4",
    "@types/estree-jsx": "^1.0.5",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.7",
    "fumadocs-core": "workspace:*",
    "fumadocs-ui": "workspace:@fumadocs/base-ui@*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsconfig": "workspace:*",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.0.0",
    "@types/mdx": "*",
    "astro": "^7.4.0",
    "fumadocs-core": "^16.18.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/mdx": {
      "optional": true
    }
  }
}
