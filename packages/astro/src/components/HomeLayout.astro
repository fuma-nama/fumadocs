---
import Layout from '../ui/Layout.astro';
import { Home } from '../ui/home.js';
import { app, getLayoutDefaults, getProviderData } from '../app.js';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** render the not found page of Fumadocs UI */
  notFound?: boolean;
}

const {
  title,
  description,
  notFound,
  lang = Astro.currentLocale ?? app.source._i18n?.defaultLanguage,
} = Astro.props;
---

<Layout title={title} description={description} lang={lang}>
  <slot name="head" slot="head" />
  <Home
    client:load
    transition:persist="home"
    provider={getProviderData(Astro, lang)}
    layout={getLayoutDefaults(lang)}
    locale={lang}
    notFound={notFound}
  >
    <slot />
  </Home>
</Layout>
