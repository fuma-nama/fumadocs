---
import type { ReactNode } from 'react';
import { toPageBody } from '../island-node.js';

interface Props {
  /** React content, like `createElement(ChangelogTimeline, { entries })` */
  node: ReactNode;
}

const content = await toPageBody({ node: Astro.props.node });
---

<content.component {...content.props} body={false} />
