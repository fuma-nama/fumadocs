---
import { findServerRoute, handleFileRoute } from '../app.js';

const route = await findServerRoute(Astro.url.pathname);
// a page rather than an endpoint: its 404 without body renders the 404 page
if (!route) return new Response(null, { status: 404 });
if (route.type === 'file') return handleFileRoute(route, Astro);
---

<route.component {...route.props} />
