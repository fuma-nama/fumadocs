---
import Layout from './Layout.astro';
import { Docs } from './docs.js';
import { app, getLayoutDefaults, getProviderData, type AnyPage } from '../app.js';

interface Props {
  page: AnyPage;
}

const { page } = Astro.props;
const body = await app.getBody(page);
const data = await app.getPageData(page, body);
const tree = await app.source.serializePageTree(app.source.getPageTree(page.locale));
const provider = getProviderData(Astro, page.locale);

const i18n = app.source._i18n;
/** the page a language shows when it has no file of its own, pages of every language (`$`) too */
function inheritedFrom(target: AnyPage) {
  if (!i18n) return;
  const language = i18n.fallbackLanguage ?? i18n.defaultLanguage;
  if (target.locale === language) return;
  const origin = app.source.getPage(target.slugs, language);
  if (origin?.path === target.path) return origin;
}

let alternates: Record<string, string> = {};
for (const language of i18n?.languages ?? []) {
  const translated = app.source.getPage(page.slugs, language);
  if (translated && !inheritedFrom(translated)) alternates[language] = translated.url;
}
const languages = Object.keys(alternates);
if (languages.length > 1)
  alternates['x-default'] = alternates[i18n!.defaultLanguage] ?? alternates[languages[0]];
else alternates = {};
---

<Layout
  lang={page.locale}
  title={data.title}
  description={data.description}
  image={data.image}
  alternates={alternates}
  noindex={inheritedFrom(page) !== undefined}
  page={page}
>
  {
    data.lastModified && (
      <meta
        slot="head"
        property="article:modified_time"
        content={data.lastModified.toISOString()}
      />
    )
  }
  <Docs
    client:load
    transition:persist="docs"
    provider={provider}
    layout={getLayoutDefaults(page.locale)}
    tree={tree}
    page={data}
  >
    <body.component {...body.props} provider={provider} />
  </Docs>
</Layout>
