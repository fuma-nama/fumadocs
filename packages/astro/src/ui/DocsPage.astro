---
import type { Page } from 'fumadocs-core/source';
import Layout from './Layout.astro';
import { Docs } from './docs.js';
import { app, getLayoutDefaults, getProviderData, getSerializedTree } from '../app.js';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const body = await app.getBody(page);
const data = await app.getPageData(page, body);
const tree = await getSerializedTree(page.locale);
const provider = getProviderData(Astro, page.locale);

const i18n = app.source._i18n;
/** the page a language shows when it has no file of its own, pages of every language (`$`) too */
function inheritedFrom(target: Page) {
  if (!i18n) return;
  const language = i18n.fallbackLanguage ?? i18n.defaultLanguage;
  if (target.locale === language) return;
  const origin = app.source.getPage(target.slugs, language);
  if (origin?.path === target.path) return origin;
}

/** the URLs of the page by language, when it has more than one */
let alternates: Record<string, string> | undefined;
if (i18n) {
  const urls: Record<string, string> = {};
  for (const language of i18n.languages) {
    const translated = app.source.getPage(page.slugs, language);
    if (translated && !inheritedFrom(translated)) urls[language] = translated.url;
  }
  const languages = Object.keys(urls);
  if (languages.length > 1)
    alternates = { ...urls, 'x-default': urls[i18n.defaultLanguage] ?? urls[languages[0]] };
}
---

<Layout
  lang={page.locale}
  title={data.title}
  description={data.description}
  image={data.image}
  alternates={alternates}
  noindex={inheritedFrom(page) !== undefined}
  page={page}
>
  {
    data.lastModified && (
      <meta
        slot="head"
        property="article:modified_time"
        content={data.lastModified.toISOString()}
      />
    )
  }
  <Docs
    client:load
    transition:persist="docs"
    provider={provider}
    layout={getLayoutDefaults(page.locale)}
    tree={tree}
    page={data}
  >
    <body.component {...body.props} provider={provider} />
  </Docs>
</Layout>
