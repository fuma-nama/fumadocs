---
import { ClientRouter } from 'astro:transitions';
import 'virtual:fumadocs/css';
import type { Page } from 'fumadocs-core/source';
import { app } from '../app.js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  /** the URLs of the page in other languages, by language */
  alternates?: Record<string, string>;
  /** keep the page out of search engines, like a page shown in the fallback language */
  noindex?: boolean;
  /** the docs page, for the `head` component */
  page?: Page;
}

const {
  title,
  description,
  image,
  alternates,
  noindex,
  page,
  lang = Astro.currentLocale ?? app.source._i18n?.defaultLanguage ?? 'en',
} = Astro.props;
const siteName = app.config.title;
const pageTitle = title ?? siteName;
const fullTitle = title && siteName ? `${title} | ${siteName}` : pageTitle;
const Head = app.config.head;
// social previews need absolute URLs
const site = Astro.site;
const url = site && new URL(Astro.url.pathname, site).href;
// in the URL format of Astro, like its sitemap: page URLs have no trailing slash
const slash = Astro.url.pathname.endsWith('/');
const toHref = (href: string) =>
  new URL(slash && !href.endsWith('/') ? `${href}/` : href, site).href;
const imageUrl = image && (site ? new URL(image, site).href : image);
---

<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fullTitle && <title>{fullTitle}</title>}
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {url && <link rel="canonical" href={url} />}
    {
      site &&
        alternates &&
        Object.entries(alternates).map(([language, href]) => (
          <link rel="alternate" hreflang={language} href={toHref(href)} />
        ))
    }
    <meta property="og:type" content="website" />
    {pageTitle && <meta property="og:title" content={pageTitle} />}
    {description && <meta property="og:description" content={description} />}
    {siteName && <meta property="og:site_name" content={siteName} />}
    {url && <meta property="og:url" content={url} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {Head && <Head page={page} />}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body style="display: flex; flex-direction: column; min-height: 100vh">
    <slot />
  </body>
</html>
